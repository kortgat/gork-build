+//! Tests for the login screen's "Skip login" and the local provider setup modal.
+
+use super::*;
+use crate::views::local_provider_modal::{Detection, LocalProviderConfig};
+
+fn pending_app() -> AppView {
+    let mut app = test_app();
+    app.auth_state = AuthState::Pending { error: None };
+    app
+}
+
+fn sample_config() -> LocalProviderConfig {
+    LocalProviderConfig {
+        key: "ollama-llama3.1-8b".into(),
+        model: "llama3.1:8b".into(),
+        base_url: "http://localhost:11434/v1".into(),
+        display_name: "llama3.1:8b (Ollama)".into(),
+        api_key: "local".into(),
+        context_window: None,
+    }
+}
+
+fn is_api_key_authenticate(effect: &Effect) -> bool {
+    matches!(
+        effect,
+        Effect::Authenticate { method_id, force_interactive: false, .. }
+            if method_id.0.as_ref() == xai_grok_shell::agent::auth_method::XAI_API_KEY_METHOD_ID
+    )
+}
+
+#[test]
+fn skip_login_without_local_model_opens_setup_and_detects() {
+    let mut app = pending_app();
+    let effects = dispatch(Action::SkipLogin, &mut app);
+    let modal = app
+        .local_provider_modal
+        .as_ref()
+        .expect("setup modal opens");
+    assert_eq!(modal.detection, Detection::Running);
+    assert!(matches!(
+        effects.as_slice(),
+        [Effect::DetectLocalModels { base_url, .. }] if base_url == "http://localhost:11434/v1"
+    ));
+    assert!(matches!(app.auth_state, AuthState::Pending { .. }));
+}
+
+#[test]
+fn skip_login_with_advertised_api_key_authenticates_directly() {
+    let mut app = pending_app();
+    app.auth_methods.insert(
+        0,
+        acp::AuthMethod::Agent(acp::AuthMethodAgent::new(
+            acp::AuthMethodId::new(xai_grok_shell::agent::auth_method::XAI_API_KEY_METHOD_ID),
+            "API key".to_string(),
+        )),
+    );
+    let effects = dispatch(Action::SkipLogin, &mut app);
+    assert!(app.local_provider_modal.is_none());
+    assert!(matches!(effects.as_slice(), [e] if is_api_key_authenticate(e)));
+    assert!(matches!(app.auth_state, AuthState::Authenticating { .. }));
+    assert!(app.is_api_key_auth);
+}
+
+#[test]
+fn save_with_invalid_form_shows_error_and_emits_nothing() {
+    let mut app = pending_app();
+    dispatch(Action::OpenLocalProviderSetup, &mut app);
+    let effects = dispatch(Action::SaveLocalProvider, &mut app);
+    assert!(effects.is_empty());
+    assert!(
+        app.local_provider_modal
+            .as_ref()
+            .and_then(|m| m.error.as_deref())
+            .is_some_and(|e| e.contains("Model is required"))
+    );
+}
+
+#[test]
+fn save_with_valid_form_emits_save_effect() {
+    let mut app = pending_app();
+    dispatch(Action::OpenLocalProviderSetup, &mut app);
+    app.local_provider_modal
+        .as_mut()
+        .unwrap()
+        .set_model("llama3.1:8b");
+    let effects = dispatch(Action::SaveLocalProvider, &mut app);
+    assert!(matches!(
+        effects.as_slice(),
+        [Effect::SaveLocalProvider { config }] if config.key == "ollama-llama3.1-8b"
+    ));
+}
+
+#[test]
+fn saved_on_login_screen_closes_modal_and_authenticates() {
+    let mut app = pending_app();
+    dispatch(Action::OpenLocalProviderSetup, &mut app);
+    let effects = dispatch(
+        Action::TaskComplete(TaskResult::LocalProviderSaved {
+            config: sample_config(),
+            result: Ok(()),
+        }),
+        &mut app,
+    );
+    assert!(app.local_provider_modal.is_none());
+    assert!(matches!(effects.as_slice(), [e] if is_api_key_authenticate(e)));
+}
+
+#[test]
+fn save_failure_keeps_modal_open_with_error() {
+    let mut app = pending_app();
+    dispatch(Action::OpenLocalProviderSetup, &mut app);
+    let effects = dispatch(
+        Action::TaskComplete(TaskResult::LocalProviderSaved {
+            config: sample_config(),
+            result: Err("Could not write config".into()),
+        }),
+        &mut app,
+    );
+    assert!(effects.is_empty());
+    assert_eq!(
+        app.local_provider_modal
+            .as_ref()
+            .and_then(|m| m.error.as_deref()),
+        Some("Could not write config")
+    );
+    assert!(matches!(app.auth_state, AuthState::Pending { .. }));
+}
+
+#[test]
+fn saved_while_signed_in_does_not_reauthenticate() {
+    let mut app = test_app();
+    app.auth_state = AuthState::Done;
+    dispatch(Action::OpenLocalProviderSetup, &mut app);
+    let effects = dispatch(
+        Action::TaskComplete(TaskResult::LocalProviderSaved {
+            config: sample_config(),
+            result: Ok(()),
+        }),
+        &mut app,
+    );
+    assert!(effects.is_empty());
+    assert!(app.local_provider_modal.is_none());
+    assert!(matches!(app.auth_state, AuthState::Done));
+    assert!(
+        app.startup_warnings
+            .iter()
+            .any(|w| w.message.contains("/model ollama-llama3.1-8b"))
+    );
+}
+
+#[test]
+fn stale_detection_result_is_dropped() {
+    let mut app = pending_app();
+    dispatch(Action::OpenLocalProviderSetup, &mut app);
+    dispatch(Action::DetectLocalModels, &mut app);
+    dispatch(
+        Action::TaskComplete(TaskResult::LocalModelsDetected {
+            request_seq: 1,
+            result: Ok(vec!["old".into()]),
+        }),
+        &mut app,
+    );
+    assert_eq!(
+        app.local_provider_modal.as_ref().unwrap().detection,
+        Detection::Running
+    );
+    dispatch(
+        Action::TaskComplete(TaskResult::LocalModelsDetected {
+            request_seq: 2,
+            result: Ok(vec!["new".into()]),
+        }),
+        &mut app,
+    );
+    assert!(matches!(
+        &app.local_provider_modal.as_ref().unwrap().detection,
+        Detection::Found { models, .. } if models == &vec!["new".to_string()]
+    ));
+}
+
+#[test]
+fn skip_during_startup_sign_in_cancels_it_and_opens_setup() {
+    let mut app = pending_app();
+    app.auth_state = AuthState::Authenticating {
+        request_seq: 7,
+        handle: None,
+        auth_url: Some("https://example/device".into()),
+        mode: AuthMode::Device,
+    };
+    let effects = dispatch(Action::SkipLogin, &mut app);
+    assert!(matches!(app.auth_state, AuthState::Pending { error: None }));
+    assert!(app.local_provider_modal.is_some());
+    assert!(matches!(
+        effects.as_slice(),
+        [
+            Effect::CancelAuth { request_seq: 7 },
+            Effect::DetectLocalModels { .. }
+        ]
+    ));
+}
