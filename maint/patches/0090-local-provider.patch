+//! Local model provider setup (Ollama and other OpenAI-compatible servers) and the login screen's "Skip login".
+//!
+//! A saved provider is a `[model.<key>]` entry with its own `api_key`, which lets the agent accept `xai.api_key`
+//! auth without any xAI credential. Skipping login is therefore "authenticate with `xai.api_key`".
+
+use crate::app::actions::Effect;
+use crate::app::app_view::{ActiveView, AppView, AuthMode, AuthState};
+use crate::scrollback::block::RenderBlock;
+use crate::views::local_provider_modal::{Detection, LocalProviderConfig, LocalProviderModalState};
+use xai_grok_shell::agent::auth_method::XAI_API_KEY_METHOD_ID;
+
+/// Login screen "Skip login": use an already-advertised API-key method (a configured local model or `XAI_API_KEY`),
+/// otherwise open the setup modal so the user can add one.
+pub(super) fn dispatch_skip_login(app: &mut AppView) -> Vec<Effect> {
+    // Startup auto-starts the browser/device sign-in; skipping abandons it here and in the shell.
+    let mut effects = Vec::new();
+    if let AuthState::Authenticating { request_seq, .. } = app.auth_state {
+        super::auth::abort_prior_auth(app);
+        app.next_auth_request_seq += 1;
+        app.auth_show_raw_url = false;
+        app.auth_state = AuthState::Pending { error: None };
+        effects.push(Effect::CancelAuth { request_seq });
+    }
+    let api_key_advertised = app
+        .auth_methods
+        .iter()
+        .any(|m| m.id().0.as_ref() == XAI_API_KEY_METHOD_ID);
+    if api_key_advertised {
+        effects.extend(authenticate_without_account(app));
+    } else {
+        effects.extend(dispatch_open_local_provider_setup(app));
+    }
+    effects
+}
+
+pub(super) fn dispatch_open_local_provider_setup(app: &mut AppView) -> Vec<Effect> {
+    let mut modal = LocalProviderModalState::new();
+    let effect = start_detection(&mut modal);
+    app.local_provider_modal = Some(modal);
+    effect.into_iter().collect()
+}
+
+pub(super) fn dispatch_detect_local_models(app: &mut AppView) -> Vec<Effect> {
+    let Some(modal) = app.local_provider_modal.as_mut() else {
+        return vec![];
+    };
+    start_detection(modal).into_iter().collect()
+}
+
+fn start_detection(modal: &mut LocalProviderModalState) -> Option<Effect> {
+    if modal.base_url().is_empty() {
+        modal.detection = Detection::Failed("enter a base URL first".to_string());
+        return None;
+    }
+    let request_seq = modal.begin_detection();
+    Some(Effect::DetectLocalModels {
+        request_seq,
+        base_url: modal.base_url().to_string(),
+        api_key: modal.api_key().to_string(),
+    })
+}
+
+pub(super) fn dispatch_save_local_provider(app: &mut AppView) -> Vec<Effect> {
+    let Some(modal) = app.local_provider_modal.as_mut() else {
+        return vec![];
+    };
+    match modal.validate() {
+        Ok(config) => {
+            modal.error = None;
+            vec![Effect::SaveLocalProvider { config }]
+        }
+        Err(e) => {
+            modal.error = Some(e);
+            vec![]
+        }
+    }
+}
+
+pub(super) fn dispatch_cancel_local_provider_setup(app: &mut AppView) -> Vec<Effect> {
+    app.local_provider_modal = None;
+    vec![]
+}
+
+pub(super) fn handle_local_models_detected(
+    app: &mut AppView,
+    request_seq: u64,
+    result: Result<Vec<String>, String>,
+) -> Vec<Effect> {
+    if let Some(modal) = app.local_provider_modal.as_mut() {
+        modal.finish_detection(request_seq, result);
+    }
+    vec![]
+}
+
+pub(super) fn handle_local_provider_saved(
+    app: &mut AppView,
+    config: LocalProviderConfig,
+    result: Result<(), String>,
+) -> Vec<Effect> {
+    if let Err(e) = result {
+        // Keep the form open so nothing typed is lost.
+        if let Some(modal) = app.local_provider_modal.as_mut() {
+            modal.error = Some(e);
+        }
+        return vec![];
+    }
+    app.local_provider_modal = None;
+    if matches!(app.auth_state, AuthState::Pending { .. }) {
+        return authenticate_without_account(app);
+    }
+    let notice = format!(
+        "Saved {} as the default model for new sessions. Switch this session with /model {}.",
+        config.display_name, config.key
+    );
+    match app.active_view {
+        ActiveView::Agent(id) if app.agents.contains_key(&id) => {
+            if let Some(agent) = app.agents.get_mut(&id) {
+                agent.scrollback.push_block(RenderBlock::system(notice));
+            }
+        }
+        _ => app.startup_warnings.push(crate::startup::StartupWarning {
+            severity: crate::startup::WarningSeverity::Info,
+            message: notice,
+            action: None,
+        }),
+    }
+    vec![]
+}
+
+/// Authenticate with the `xai.api_key` method. The agent accepts it when `XAI_API_KEY` is set or any configured model
+/// carries its own credential; otherwise the error comes back through `AuthFailed` onto the login screen.
+fn authenticate_without_account(app: &mut AppView) -> Vec<Effect> {
+    let request_seq = app.next_auth_request_seq;
+    app.next_auth_request_seq += 1;
+    app.auth_code_input.reset();
+    app.auth_state = AuthState::Authenticating {
+        request_seq,
+        handle: None,
+        auth_url: None,
+        mode: AuthMode::Pending,
+    };
+    app.is_api_key_auth = true;
+    app.usage_visible = false;
+    vec![Effect::Authenticate {
+        request_seq,
+        method_id: agent_client_protocol::AuthMethodId::new(XAI_API_KEY_METHOD_ID),
+        use_oauth: false,
+        force_interactive: false,
+    }]
+}
