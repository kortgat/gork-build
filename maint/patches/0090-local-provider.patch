+//! Modal for configuring a local (or any OpenAI-compatible) model provider such as Ollama.
+//!
+//! Reachable from the login screen ("Skip login") and from `/local-provider` in a session.
+//! Saving writes a `[model.<key>]` entry plus `[models].default` to `~/.grok/config.toml`; the model carries its own
+//! credential, so the agent accepts `xai.api_key` auth without a Grok account and later launches skip the login screen.
+
+use crossterm::event::{KeyCode, KeyEvent, KeyModifiers};
+use ratatui::buffer::Buffer;
+use ratatui::layout::Rect;
+use ratatui::style::{Modifier, Style};
+use ratatui::text::{Line, Span};
+use ratatui::widgets::{Paragraph, Widget, Wrap};
+
+use crate::input::line_editor::{LineEditOutcome, LineEditor};
+use crate::theme::Theme;
+use crate::views::modal_window::{
+    ModalSizing, ModalWindowConfig, ModalWindowOutcome, ModalWindowState, Shortcut,
+    handle_modal_mouse, render_modal_window,
+};
+
+const SHORTCUT_ID_HINT: usize = usize::MAX;
+const SHORTCUT_ID_DETECT: usize = 0;
+const SHORTCUT_ID_SAVE: usize = 1;
+const SHORTCUT_ID_CANCEL: usize = 2;
+
+/// Credential written when the user leaves the API key blank. Local servers ignore it, but a non-empty `api_key` is
+/// what marks the model as carrying its own credential (`has_own_credentials`), which unlocks login-free auth.
+pub const PLACEHOLDER_API_KEY: &str = "local";
+
+/// Width of the label column in the form.
+const LABEL_WIDTH: usize = 16;
+
+/// Well-known local servers that speak the OpenAI Chat Completions API.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum ProviderPreset {
+    Ollama,
+    LmStudio,
+    LlamaCpp,
+    Vllm,
+    Custom,
+}
+
+impl ProviderPreset {
+    pub const ALL: [ProviderPreset; 5] = [
+        Self::Ollama,
+        Self::LmStudio,
+        Self::LlamaCpp,
+        Self::Vllm,
+        Self::Custom,
+    ];
+
+    pub fn label(self) -> &'static str {
+        match self {
+            Self::Ollama => "Ollama",
+            Self::LmStudio => "LM Studio",
+            Self::LlamaCpp => "llama.cpp server",
+            Self::Vllm => "vLLM",
+            Self::Custom => "Custom (OpenAI-compatible)",
+        }
+    }
+
+    pub fn default_base_url(self) -> &'static str {
+        match self {
+            Self::Ollama => "http://localhost:11434/v1",
+            Self::LmStudio => "http://localhost:1234/v1",
+            Self::LlamaCpp => "http://localhost:8080/v1",
+            Self::Vllm => "http://localhost:8000/v1",
+            Self::Custom => "",
+        }
+    }
+
+    /// Prefix for the generated `[model.<key>]` catalog key.
+    fn key_prefix(self) -> &'static str {
+        match self {
+            Self::Ollama => "ollama",
+            Self::LmStudio => "lmstudio",
+            Self::LlamaCpp => "llamacpp",
+            Self::Vllm => "vllm",
+            Self::Custom => "local",
+        }
+    }
+
+    fn cycle(self, forward: bool) -> Self {
+        step_in(&Self::ALL, self, forward)
+    }
+}
+
+/// The neighbour of `current` in `all`, wrapping at both ends.
+fn step_in<T: Copy + PartialEq>(all: &[T], current: T, forward: bool) -> T {
+    let n = all.len();
+    let i = all.iter().position(|x| *x == current).unwrap_or(0);
+    let next = if forward {
+        (i + 1) % n
+    } else {
+        (i + n - 1) % n
+    };
+    all.get(next).copied().unwrap_or(current)
+}
+
+/// Wrapping step through `0..len`; `len` must be non-zero.
+fn wrap_index(index: usize, len: usize, forward: bool) -> usize {
+    if forward {
+        (index + 1) % len
+    } else {
+        (index + len - 1) % len
+    }
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Field {
+    Preset,
+    BaseUrl,
+    Model,
+    ApiKey,
+    ContextWindow,
+}
+
+impl Field {
+    const ALL: [Field; 5] = [
+        Self::Preset,
+        Self::BaseUrl,
+        Self::Model,
+        Self::ApiKey,
+        Self::ContextWindow,
+    ];
+
+    fn label(self) -> &'static str {
+        match self {
+            Self::Preset => "Provider",
+            Self::BaseUrl => "Base URL",
+            Self::Model => "Model",
+            Self::ApiKey => "API key",
+            Self::ContextWindow => "Context window",
+        }
+    }
+
+    fn step(self, forward: bool) -> Self {
+        step_in(&Self::ALL, self, forward)
+    }
+}
+
+/// Result of probing `{base_url}/models`.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum Detection {
+    Idle,
+    Running,
+    Found { models: Vec<String>, index: usize },
+    Failed(String),
+}
+
+/// Validated form contents, ready to be written to `config.toml`.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct LocalProviderConfig {
+    /// `[model.<key>]` catalog key, also the `/model` argument.
+    pub key: String,
+    pub model: String,
+    pub base_url: String,
+    pub display_name: String,
+    pub api_key: String,
+    pub context_window: Option<u64>,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum LocalProviderModalOutcome {
+    Cancelled,
+    /// User asked to save (Enter / footer click). The caller validates via [`LocalProviderModalState::validate`].
+    Submit,
+    /// Base URL changed or user asked to (re)detect models.
+    Detect,
+    Changed,
+    Unchanged,
+}
+
+pub struct LocalProviderModalState {
+    pub preset: ProviderPreset,
+    base_url: LineEditor,
+    model: LineEditor,
+    api_key: LineEditor,
+    context_window: LineEditor,
+    pub focus: Field,
+    pub detection: Detection,
+    /// Sequence of the in-flight detection, so a stale result for an old URL is dropped.
+    pub detect_seq: u64,
+    /// Validation or save error shown under the form.
+    pub error: Option<String>,
+    pub window: ModalWindowState,
+    /// Row rects for click-to-focus; filled by the renderer.
+    field_rects: Vec<(Field, Rect)>,
+    /// The base URL the last detection ran against; leaving the URL field with a different value re-detects.
+    detected_url: String,
+    /// The model came from a detected list (not typed), so a later detection against another server may replace it.
+    model_from_detection: bool,
+}
+
+impl Default for LocalProviderModalState {
+    fn default() -> Self {
+        Self::new()
+    }
+}
+
+impl LocalProviderModalState {
+    pub fn new() -> Self {
+        let preset = ProviderPreset::Ollama;
+        let mut base_url = LineEditor::default();
+        base_url.set_text(preset.default_base_url());
+        Self {
+            preset,
+            base_url,
+            model: LineEditor::default(),
+            api_key: LineEditor::default(),
+            context_window: LineEditor::default(),
+            focus: Field::Preset,
+            detection: Detection::Idle,
+            detect_seq: 0,
+            error: None,
+            window: ModalWindowState::new(),
+            field_rects: Vec::new(),
+            detected_url: String::new(),
+            model_from_detection: false,
+        }
+    }
+
+    pub fn base_url(&self) -> &str {
+        self.base_url.text().trim()
+    }
+
+    pub fn api_key(&self) -> &str {
+        self.api_key.text().trim()
+    }
+
+    #[cfg(test)]
+    pub(crate) fn set_model(&mut self, model: &str) {
+        self.model.set_text(model);
+    }
+
+    #[cfg(test)]
+    pub(crate) fn set_context_window(&mut self, value: &str) {
+        self.context_window.set_text(value);
+    }
+
+    #[cfg(test)]
+    pub(crate) fn set_base_url(&mut self, value: &str) {
+        self.base_url.set_text(value);
+    }
+
+    /// Record that a detection for the current base URL has been started; returns its sequence number.
+    pub fn begin_detection(&mut self) -> u64 {
+        self.detect_seq += 1;
+        self.detected_url = self.base_url().to_string();
+        self.detection = Detection::Running;
+        self.detect_seq
+    }
+
+    /// Apply a detection result. Fills an empty model field with the first detected model.
+    pub fn finish_detection(&mut self, seq: u64, result: Result<Vec<String>, String>) {
+        if seq != self.detect_seq {
+            return;
+        }
+        self.detection = match result {
+            Ok(models) => {
+                let Some(first) = models.first().cloned() else {
+                    self.detection =
+                        Detection::Failed("server is up but reports no models".to_string());
+                    return;
+                };
+                let current = self.model.text().trim().to_string();
+                let found = models.iter().position(|m| *m == current);
+                let index = found.unwrap_or(0);
+                if current.is_empty() || (self.model_from_detection && found.is_none()) {
+                    self.model.set_text(first);
+                    self.model_from_detection = true;
+                }
+                Detection::Found { models, index }
+            }
+            Err(e) => Detection::Failed(e),
+        };
+    }
+
+    fn cycle_detected(&mut self, forward: bool) -> bool {
+        let Detection::Found { models, index } = &mut self.detection else {
+            return false;
+        };
+        if models.is_empty() {
+            return false;
+        }
+        *index = wrap_index(*index, models.len(), forward);
+        let Some(model) = models.get(*index).cloned() else {
+            return false;
+        };
+        self.model.set_text(model);
+        self.model_from_detection = true;
+        true
+    }
+
+    fn set_preset(&mut self, preset: ProviderPreset) {
+        // Only replace the URL when the user has not typed their own.
+        let url = self.base_url().to_string();
+        let url_is_a_default = ProviderPreset::ALL
+            .iter()
+            .any(|p| p.default_base_url() == url);
+        self.preset = preset;
+        if url_is_a_default {
+            self.base_url.set_text(preset.default_base_url());
+        }
+        self.detection = Detection::Idle;
+    }
+
+    fn editor_mut(&mut self, field: Field) -> Option<&mut LineEditor> {
+        match field {
+            Field::Preset => None,
+            Field::BaseUrl => Some(&mut self.base_url),
+            Field::Model => Some(&mut self.model),
+            Field::ApiKey => Some(&mut self.api_key),
+            Field::ContextWindow => Some(&mut self.context_window),
+        }
+    }
+
+    /// Move focus; leaving the URL field with an undetected URL asks the caller to detect.
+    fn move_focus(&mut self, next: Field) -> LocalProviderModalOutcome {
+        let leaving_url = self.focus == Field::BaseUrl && next != Field::BaseUrl;
+        self.focus = next;
+        if leaving_url && self.base_url() != self.detected_url && !self.base_url().is_empty() {
+            return LocalProviderModalOutcome::Detect;
+        }
+        LocalProviderModalOutcome::Changed
+    }
+
+    pub fn insert_paste(&mut self, text: &str) -> LocalProviderModalOutcome {
+        let text = crate::input::line_editor::sanitize_single_line(text);
+        let focus = self.focus;
+        match self.editor_mut(focus) {
+            Some(editor) => from_line_edit(editor.insert_paste(text.trim())),
+            None => LocalProviderModalOutcome::Unchanged,
+        }
+    }
+
+    pub fn handle_key(&mut self, key: &KeyEvent) -> LocalProviderModalOutcome {
+        if crate::input::key::is_paste_key(key) {
+            return crate::clipboard::system_clipboard_get()
+                .map_or(LocalProviderModalOutcome::Unchanged, |text| {
+                    self.insert_paste(&text)
+                });
+        }
+        let ctrl = key.modifiers.contains(KeyModifiers::CONTROL)
+            && !crate::input::key::is_altgr(key.modifiers);
+        if ctrl {
+            return match key.code {
+                KeyCode::Char('c' | 'q') => LocalProviderModalOutcome::Cancelled,
+                KeyCode::Char('r') => LocalProviderModalOutcome::Detect,
+                KeyCode::Char('s') => LocalProviderModalOutcome::Submit,
+                KeyCode::Char('n') if self.cycle_detected(true) => {
+                    LocalProviderModalOutcome::Changed
+                }
+                KeyCode::Char('p') if self.cycle_detected(false) => {
+                    LocalProviderModalOutcome::Changed
+                }
+                _ => self.edit_focused(key),
+            };
+        }
+        match key.code {
+            KeyCode::Esc => LocalProviderModalOutcome::Cancelled,
+            KeyCode::Enter if key.modifiers.is_empty() => LocalProviderModalOutcome::Submit,
+            KeyCode::Tab | KeyCode::Down => self.move_focus(self.focus.step(true)),
+            KeyCode::BackTab | KeyCode::Up => self.move_focus(self.focus.step(false)),
+            KeyCode::Left | KeyCode::Right | KeyCode::Char(' ') if self.focus == Field::Preset => {
+                self.set_preset(self.preset.cycle(key.code != KeyCode::Left));
+                LocalProviderModalOutcome::Detect
+            }
+            _ => self.edit_focused(key),
+        }
+    }
+
+    fn edit_focused(&mut self, key: &KeyEvent) -> LocalProviderModalOutcome {
+        let focus = self.focus;
+        let Some(editor) = self.editor_mut(focus) else {
+            return LocalProviderModalOutcome::Unchanged;
+        };
+        let outcome = if focus == Field::ContextWindow {
+            editor.handle_key_with_insert_policy(key, |c| c.is_ascii_digit())
+        } else {
+            editor.handle_key_with_insert_policy(key, |c| !c.is_control())
+        };
+        let result = from_line_edit(outcome);
+        if focus == Field::Model && outcome == LineEditOutcome::TextChanged {
+            self.model_from_detection = false;
+            // A typed model name no longer tracks the detected-list cursor.
+            if let Detection::Found { models, index } = &mut self.detection
+                && let Some(i) = models.iter().position(|m| m == self.model.text().trim())
+            {
+                *index = i;
+            }
+        }
+        if result == LocalProviderModalOutcome::Changed {
+            self.error = None;
+        }
+        result
+    }
+
+    pub fn handle_mouse(
+        &mut self,
+        kind: crossterm::event::MouseEventKind,
+        column: u16,
+        row: u16,
+    ) -> LocalProviderModalOutcome {
+        use crossterm::event::{MouseButton, MouseEventKind};
+        match handle_modal_mouse(&mut self.window, kind, column, row) {
+            ModalWindowOutcome::CloseRequested => return LocalProviderModalOutcome::Cancelled,
+            ModalWindowOutcome::ShortcutActivated(SHORTCUT_ID_DETECT) => {
+                return LocalProviderModalOutcome::Detect;
+            }
+            ModalWindowOutcome::ShortcutActivated(SHORTCUT_ID_SAVE) => {
+                return LocalProviderModalOutcome::Submit;
+            }
+            ModalWindowOutcome::ShortcutActivated(SHORTCUT_ID_CANCEL) => {
+                return LocalProviderModalOutcome::Cancelled;
+            }
+            ModalWindowOutcome::Handled => return LocalProviderModalOutcome::Changed,
+            _ => {}
+        }
+        if let MouseEventKind::Down(MouseButton::Left) = kind {
+            let hit = self
+                .field_rects
+                .iter()
+                .find(|(_, r)| r.contains(ratatui::layout::Position::new(column, row)))
+                .map(|(f, _)| *f);
+            if let Some(field) = hit {
+                if field == Field::Preset && self.focus == Field::Preset {
+                    self.set_preset(self.preset.cycle(true));
+                    return LocalProviderModalOutcome::Detect;
+                }
+                return self.move_focus(field);
+            }
+        }
+        LocalProviderModalOutcome::Unchanged
+    }
+
+    /// Validate the form and build the config entry, or return a message for the user.
+    pub fn validate(&self) -> Result<LocalProviderConfig, String> {
+        let base_url = self.base_url().trim_end_matches('/').to_string();
+        if base_url.is_empty() {
+            return Err("Base URL is required".to_string());
+        }
+        if !(base_url.starts_with("http://") || base_url.starts_with("https://")) {
+            return Err("Base URL must start with http:// or https://".to_string());
+        }
+        let model = self.model.text().trim().to_string();
+        if model.is_empty() {
+            return Err("Model is required (Ctrl+R detects installed models)".to_string());
+        }
+        let context_window = match self.context_window.text().trim() {
+            "" => None,
+            s => match s.parse::<u64>() {
+                Ok(n) if n >= 1024 => Some(n),
+                _ => return Err("Context window must be a number of tokens (>= 1024)".to_string()),
+            },
+        };
+        let api_key = match self.api_key() {
+            "" => PLACEHOLDER_API_KEY.to_string(),
+            k => k.to_string(),
+        };
+        Ok(LocalProviderConfig {
+            key: model_key(self.preset, &model),
+            display_name: format!("{model} ({})", self.preset.label()),
+            model,
+            base_url,
+            api_key,
+            context_window,
+        })
+    }
+}
+
+fn from_line_edit(outcome: LineEditOutcome) -> LocalProviderModalOutcome {
+    match outcome {
+        LineEditOutcome::TextChanged
+        | LineEditOutcome::CursorChanged
+        | LineEditOutcome::HandledNoChange => LocalProviderModalOutcome::Changed,
+        LineEditOutcome::Unhandled => LocalProviderModalOutcome::Unchanged,
+    }
+}
+
+/// Build a `/model`-friendly catalog key: `<prefix>-<model>` lowercased, with runs of other characters collapsed to `-`.
+pub fn model_key(preset: ProviderPreset, model: &str) -> String {
+    let mut key = String::from(preset.key_prefix());
+    key.push('-');
+    let mut last_dash = true;
+    for c in model.chars().flat_map(char::to_lowercase) {
+        if c.is_ascii_alphanumeric() || c == '.' || c == '_' {
+            key.push(c);
+            last_dash = false;
+        } else if !last_dash {
+            key.push('-');
+            last_dash = true;
+        }
+    }
+    while key.ends_with('-') {
+        key.pop();
+    }
+    key
+}
+
+/// Parse an OpenAI-style `/models` response (`{"data":[{"id":..}]}`), also accepting Ollama's `/api/tags` shape
+/// (`{"models":[{"name":..}]}`).
+pub fn parse_models_response(body: &str) -> Result<Vec<String>, String> {
+    let v: serde_json::Value =
+        serde_json::from_str(body).map_err(|e| format!("unexpected response: {e}"))?;
+    let from = |list: Option<&serde_json::Value>, field: &str| -> Option<Vec<String>> {
+        list.and_then(|l| l.as_array()).map(|items| {
+            items
+                .iter()
+                .filter_map(|m| m.get(field).and_then(|s| s.as_str()).map(str::to_string))
+                .collect()
+        })
+    };
+    let mut models = from(v.get("data"), "id")
+        .or_else(|| from(v.get("models"), "name"))
+        .ok_or_else(|| "response has no model list".to_string())?;
+    models.sort();
+    models.dedup();
+    Ok(models)
+}
+
+/// GET `{base_url}/models` with a short timeout.
+pub async fn detect_models(base_url: String, api_key: String) -> Result<Vec<String>, String> {
+    let url = format!("{}/models", base_url.trim_end_matches('/'));
+    let mut req = xai_grok_shell::http::shared_client()
+        .get(&url)
+        .timeout(std::time::Duration::from_secs(4));
+    if !api_key.is_empty() {
+        req = req.bearer_auth(api_key);
+    }
+    let resp = req.send().await.map_err(|e| {
+        if e.is_connect() {
+            format!("cannot connect to {base_url} (is the server running?)")
+        } else if e.is_timeout() {
+            format!("timed out contacting {base_url}")
+        } else {
+            e.to_string()
+        }
+    })?;
+    let status = resp.status();
+    if !status.is_success() {
+        return Err(format!("{url} returned HTTP {}", status.as_u16()));
+    }
+    let body = resp.text().await.map_err(|e| e.to_string())?;
+    parse_models_response(&body)
+}
+
+/// Render the modal centered in `area`.
+pub fn render_local_provider_modal(
+    buf: &mut Buffer,
+    area: Rect,
+    state: &mut LocalProviderModalState,
+    theme: &Theme,
+    compact: bool,
+) {
+    let has_detected = matches!(state.detection, Detection::Found { .. });
+    let mut shortcuts = vec![
+        Shortcut {
+            label: "Tab/\u{2191}\u{2193} field",
+            clickable: false,
+            id: SHORTCUT_ID_HINT,
+        },
+        Shortcut {
+            label: "^R detect",
+            clickable: true,
+            id: SHORTCUT_ID_DETECT,
+        },
+    ];
+    if has_detected {
+        shortcuts.push(Shortcut {
+            label: "^N/^P model",
+            clickable: false,
+            id: SHORTCUT_ID_HINT,
+        });
+    }
+    shortcuts.push(Shortcut {
+        label: "Enter save",
+        clickable: true,
+        id: SHORTCUT_ID_SAVE,
+    });
+    shortcuts.push(Shortcut {
+        label: "Esc cancel",
+        clickable: true,
+        id: SHORTCUT_ID_CANCEL,
+    });
+    let config = ModalWindowConfig {
+        title: "Set up a local model provider",
+        tabs: None,
+        shortcuts: &shortcuts,
+        sizing: ModalSizing::medium().with_compact(compact),
+        fold_info: None,
+    };
+    let Some(areas) = render_modal_window(buf, area, &mut state.window, &config, theme) else {
+        return;
+    };
+    let content = areas.content;
+    state.field_rects.clear();
+
+    let label_style = Style::default().fg(theme.text_secondary);
+    let value_style = Style::default().fg(theme.text_primary);
+    let dim = Style::default().fg(theme.gray_dim);
+    let mut y = content.y;
+    let bottom = content.y + content.height;
+    let value_x = content.x + LABEL_WIDTH as u16 + 2;
+    let value_width = content.width.saturating_sub(LABEL_WIDTH as u16 + 2) as usize;
+
+    for field in Field::ALL {
+        if y >= bottom {
+            return;
+        }
+        let row = Rect::new(content.x, y, content.width, 1);
+        state.field_rects.push((field, row));
+        let focused = state.focus == field;
+        if focused {
+            buf.set_style(row, Style::default().bg(theme.bg_highlight));
+        }
+        let marker = if focused { "\u{203a} " } else { "  " };
+        let label = format!("{marker}{:<width$}", field.label(), width = LABEL_WIDTH);
+        let lstyle = if focused {
+            label_style.add_modifier(Modifier::BOLD)
+        } else {
+            label_style
+        };
+        buf.set_span(content.x, y, &Span::styled(label, lstyle), content.width);
+
+        match field {
+            Field::Preset => {
+                let text = format!("\u{2039} {} \u{203a}", state.preset.label());
+                buf.set_span(
+                    value_x,
+                    y,
+                    &Span::styled(text, value_style),
+                    value_width as u16,
+                );
+            }
+            _ => {
+                let placeholder = match field {
+                    Field::BaseUrl => "http://localhost:11434/v1",
+                    Field::Model => "e.g. qwen2.5-coder:7b",
+                    Field::ApiKey => "optional (local servers don't need one)",
+                    Field::ContextWindow => "optional, tokens (default 200000)",
+                    Field::Preset => "",
+                };
+                let masked = field == Field::ApiKey;
+                let editor = match field {
+                    Field::BaseUrl => &state.base_url,
+                    Field::Model => &state.model,
+                    Field::ApiKey => &state.api_key,
+                    _ => &state.context_window,
+                };
+                render_editor(
+                    buf,
+                    Rect::new(value_x, y, value_width as u16, 1),
+                    editor,
+                    focused,
+                    masked,
+                    placeholder,
+                    value_style,
+                    dim,
+                    theme,
+                );
+            }
+        }
+        if focused && theme.is_bandless() {
+            buf.set_style(row, Style::default().add_modifier(Modifier::REVERSED));
+        }
+        y += 1;
+    }
+
+    y += 1;
+    let mut status_lines: Vec<Line<'_>> = Vec::new();
+    match &state.detection {
+        Detection::Idle => status_lines.push(Line::from(Span::styled(
+            "Press Ctrl+R to list the models this server has installed.",
+            dim,
+        ))),
+        Detection::Running => status_lines.push(Line::from(Span::styled(
+            format!("Detecting models at {}\u{2026}", state.base_url()),
+            dim,
+        ))),
+        Detection::Found { models, index } => {
+            let mut spans = vec![Span::styled(
+                format!("\u{2713} {} model(s): ", models.len()),
+                Style::default().fg(theme.accent_success),
+            )];
+            for (i, m) in models.iter().enumerate() {
+                if i > 0 {
+                    spans.push(Span::styled(", ", dim));
+                }
+                let style = if i == *index {
+                    value_style.add_modifier(Modifier::BOLD)
+                } else {
+                    dim
+                };
+                spans.push(Span::styled(m.clone(), style));
+            }
+            status_lines.push(Line::from(spans));
+        }
+        Detection::Failed(e) => status_lines.push(Line::from(Span::styled(
+            format!("\u{2717} {e}"),
+            Style::default().fg(theme.accent_error),
+        ))),
+    }
+    if let Some(err) = &state.error {
+        status_lines.push(Line::from(Span::styled(
+            err.clone(),
+            Style::default().fg(theme.accent_error),
+        )));
+    }
+    status_lines.push(Line::from(""));
+    status_lines.push(Line::from(Span::styled(
+        "Saves to ~/.grok/config.toml as the default model. No Grok account needed.",
+        dim,
+    )));
+    if y < bottom {
+        Paragraph::new(status_lines)
+            .wrap(Wrap { trim: true })
+            .render(Rect::new(content.x, y, content.width, bottom - y), buf);
+    }
+}
+
+#[allow(clippy::too_many_arguments)]
+fn render_editor(
+    buf: &mut Buffer,
+    area: Rect,
+    editor: &LineEditor,
+    focused: bool,
+    masked: bool,
+    placeholder: &str,
+    value_style: Style,
+    dim: Style,
+    theme: &Theme,
+) {
+    let width = area.width as usize;
+    if width == 0 {
+        return;
+    }
+    let text = editor.text();
+    if text.is_empty() {
+        if !focused {
+            buf.set_span(area.x, area.y, &Span::styled(placeholder, dim), area.width);
+        } else if let Some(cell) = buf.cell_mut((area.x, area.y)) {
+            cell.set_style(theme.block_cursor_over(theme.bg_highlight));
+        }
+        return;
+    }
+    let viewport = editor.viewport(width.saturating_sub(1));
+    let visible = &text[viewport.visible_byte_range.clone()];
+    let shown = if masked {
+        "\u{2022}".repeat(visible.chars().count())
+    } else {
+        visible.to_string()
+    };
+    buf.set_span(
+        area.x,
+        area.y,
+        &Span::styled(shown, value_style),
+        area.width,
+    );
+    if focused {
+        let cx = area.x + viewport.cursor_display_column as u16;
+        if let Some(cell) = buf.cell_mut((cx, area.y)) {
+            cell.set_style(theme.block_cursor_over(theme.bg_highlight));
+        }
+    }
+}
