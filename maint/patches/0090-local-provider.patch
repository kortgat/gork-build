+/// Write `[model.<key>]` for a local provider and make it `[models].default`, preserving every other key and table.
+/// Refuses (error) rather than clobbering a non-blank config that does not parse.
+pub(crate) fn upsert_local_model(
+    path: &Path,
+    cfg: &crate::views::local_provider_modal::LocalProviderConfig,
+) -> std::io::Result<()> {
+    if let Some(parent) = path.parent() {
+        std::fs::create_dir_all(parent)?;
+    }
+    let Some(mut doc) = read_config_document_for_edit(path) else {
+        return Err(std::io::Error::new(
+            std::io::ErrorKind::InvalidData,
+            "config.toml is not valid TOML; fix it or add the model by hand",
+        ));
+    };
+    let model_tables = doc
+        .entry("model")
+        .or_insert(toml_edit::table())
+        .as_table_mut()
+        .ok_or_else(|| {
+            std::io::Error::new(
+                std::io::ErrorKind::InvalidData,
+                "`model` in config.toml is not a table",
+            )
+        })?;
+    // Implicit parent so the file reads `[model.<key>]` rather than an empty `[model]` header.
+    model_tables.set_implicit(true);
+    let mut entry = toml_edit::Table::new();
+    entry.insert("model", toml_edit::value(cfg.model.as_str()));
+    entry.insert("base_url", toml_edit::value(cfg.base_url.as_str()));
+    entry.insert("name", toml_edit::value(cfg.display_name.as_str()));
+    entry.insert("api_key", toml_edit::value(cfg.api_key.as_str()));
+    entry.insert("api_backend", toml_edit::value("chat_completions"));
+    if let Some(n) = cfg.context_window {
+        entry.insert("context_window", toml_edit::value(n as i64));
+    }
+    model_tables.insert(&cfg.key, toml_edit::Item::Table(entry));
+
+    let models = doc
+        .entry("models")
+        .or_insert(toml_edit::table())
+        .as_table_mut()
+        .ok_or_else(|| {
+            std::io::Error::new(
+                std::io::ErrorKind::InvalidData,
+                "`models` in config.toml is not a table",
+            )
+        })?;
+    models.insert("default", toml_edit::value(cfg.key.as_str()));
+    // Titles/summaries otherwise go to a built-in Grok model at this model's base URL, which a local server rejects.
+    if !models.contains_key("session_summary") {
+        models.insert("session_summary", toml_edit::value(cfg.key.as_str()));
+    }
+    write_owner_only(path, &doc.to_string())
+}
+
+/// The entry may hold a real API key, so keep the file owner-only like `auth.json`.
+fn write_owner_only(path: &Path, contents: &str) -> std::io::Result<()> {
+    std::fs::write(path, contents)?;
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::PermissionsExt;
+        std::fs::set_permissions(path, std::fs::Permissions::from_mode(0o600))?;
+    }
+    Ok(())
+}
