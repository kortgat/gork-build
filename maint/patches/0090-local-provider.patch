+/// Route input to the local provider modal; it swallows everything while open.
+fn local_provider_modal_input(
+    modal: &mut crate::views::local_provider_modal::LocalProviderModalState,
+    ev: &Event,
+) -> InputOutcome {
+    use crate::views::local_provider_modal::LocalProviderModalOutcome as O;
+    let outcome = match ev {
+        Event::Key(key) if key.kind == KeyEventKind::Release => return InputOutcome::Unchanged,
+        Event::Key(key) => modal.handle_key(key),
+        Event::Mouse(mouse) => modal.handle_mouse(mouse.kind, mouse.column, mouse.row),
+        Event::Paste(text) => modal.insert_paste(text),
+        Event::Resize(..) => O::Changed,
+        _ => O::Unchanged,
+    };
+    match outcome {
+        O::Cancelled => InputOutcome::Action(Action::CancelLocalProviderSetup),
+        O::Submit => InputOutcome::Action(Action::SaveLocalProvider),
+        O::Detect => InputOutcome::Action(Action::DetectLocalModels),
+        O::Changed => InputOutcome::Changed,
+        O::Unchanged => InputOutcome::Unchanged,
+    }
+}
