+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crossterm::event::KeyEventKind;
+
+    fn key(code: KeyCode) -> KeyEvent {
+        KeyEvent {
+            code,
+            modifiers: KeyModifiers::NONE,
+            kind: KeyEventKind::Press,
+            state: crossterm::event::KeyEventState::NONE,
+        }
+    }
+
+    fn ctrl(c: char) -> KeyEvent {
+        KeyEvent {
+            code: KeyCode::Char(c),
+            modifiers: KeyModifiers::CONTROL,
+            kind: KeyEventKind::Press,
+            state: crossterm::event::KeyEventState::NONE,
+        }
+    }
+
+    #[test]
+    fn model_key_is_slash_command_friendly() {
+        assert_eq!(
+            model_key(ProviderPreset::Ollama, "qwen2.5-coder:7b"),
+            "ollama-qwen2.5-coder-7b"
+        );
+        assert_eq!(
+            model_key(ProviderPreset::LmStudio, "Org/Model Name::Q4"),
+            "lmstudio-org-model-name-q4"
+        );
+        assert_eq!(model_key(ProviderPreset::Custom, "--"), "local");
+    }
+
+    #[test]
+    fn parses_openai_and_ollama_model_lists() {
+        let openai = r#"{"object":"list","data":[{"id":"b"},{"id":"a"},{"id":"a"}]}"#;
+        assert_eq!(parse_models_response(openai).unwrap(), vec!["a", "b"]);
+        let ollama = r#"{"models":[{"name":"llama3.1:8b"}]}"#;
+        assert_eq!(parse_models_response(ollama).unwrap(), vec!["llama3.1:8b"]);
+        assert!(parse_models_response("{}").is_err());
+        assert!(parse_models_response("not json").is_err());
+    }
+
+    #[test]
+    fn preset_cycle_replaces_default_url_but_keeps_custom_url() {
+        let mut s = LocalProviderModalState::new();
+        assert_eq!(s.base_url(), "http://localhost:11434/v1");
+        assert_eq!(
+            s.handle_key(&key(KeyCode::Right)),
+            LocalProviderModalOutcome::Detect
+        );
+        assert_eq!(s.preset, ProviderPreset::LmStudio);
+        assert_eq!(s.base_url(), "http://localhost:1234/v1");
+
+        s.set_base_url("http://gpu-box:9000/v1");
+        s.handle_key(&key(KeyCode::Right));
+        assert_eq!(s.preset, ProviderPreset::LlamaCpp);
+        assert_eq!(s.base_url(), "http://gpu-box:9000/v1");
+    }
+
+    #[test]
+    fn leaving_an_edited_url_requests_detection() {
+        let mut s = LocalProviderModalState::new();
+        s.handle_key(&key(KeyCode::Tab));
+        assert_eq!(s.focus, Field::BaseUrl);
+        s.handle_key(&key(KeyCode::Char('x')));
+        assert_eq!(
+            s.handle_key(&key(KeyCode::Tab)),
+            LocalProviderModalOutcome::Detect
+        );
+        assert_eq!(s.focus, Field::Model);
+    }
+
+    #[test]
+    fn detection_fills_empty_model_and_cycles() {
+        let mut s = LocalProviderModalState::new();
+        let seq = s.begin_detection();
+        s.finish_detection(seq, Ok(vec!["a".into(), "b".into()]));
+        assert_eq!(s.validate().unwrap().model, "a");
+        assert_eq!(s.handle_key(&ctrl('n')), LocalProviderModalOutcome::Changed);
+        assert_eq!(s.validate().unwrap().model, "b");
+        assert_eq!(s.handle_key(&ctrl('n')), LocalProviderModalOutcome::Changed);
+        assert_eq!(s.validate().unwrap().model, "a");
+    }
+
+    #[test]
+    fn redetecting_another_server_replaces_detected_but_keeps_typed_model() {
+        let mut s = LocalProviderModalState::new();
+        let seq = s.begin_detection();
+        s.finish_detection(seq, Ok(vec!["first-server".into()]));
+        let seq = s.begin_detection();
+        s.finish_detection(seq, Ok(vec!["second-server".into()]));
+        assert_eq!(s.validate().unwrap().model, "second-server");
+
+        s.focus = Field::Model;
+        s.handle_key(&key(KeyCode::Char('x')));
+        let seq = s.begin_detection();
+        s.finish_detection(seq, Ok(vec!["third-server".into()]));
+        assert_eq!(s.validate().unwrap().model, "second-serverx");
+    }
+
+    #[test]
+    fn stale_detection_is_ignored() {
+        let mut s = LocalProviderModalState::new();
+        let old = s.begin_detection();
+        let _new = s.begin_detection();
+        s.finish_detection(old, Ok(vec!["stale".into()]));
+        assert_eq!(s.detection, Detection::Running);
+    }
+
+    #[test]
+    fn validate_fills_placeholder_key_and_checks_inputs() {
+        let mut s = LocalProviderModalState::new();
+        assert!(s.validate().is_err(), "model is required");
+        s.set_model("llama3.1:8b");
+        let cfg = s.validate().unwrap();
+        assert_eq!(cfg.api_key, PLACEHOLDER_API_KEY);
+        assert_eq!(cfg.base_url, "http://localhost:11434/v1");
+        assert_eq!(cfg.key, "ollama-llama3.1-8b");
+        assert_eq!(cfg.display_name, "llama3.1:8b (Ollama)");
+        assert_eq!(cfg.context_window, None);
+
+        s.set_context_window("32768");
+        assert_eq!(s.validate().unwrap().context_window, Some(32768));
+        s.set_context_window("12");
+        assert!(s.validate().is_err());
+        s.set_context_window("");
+
+        s.set_base_url("localhost:11434");
+        assert!(s.validate().is_err());
+    }
+
+    #[test]
+    fn context_window_accepts_digits_only() {
+        let mut s = LocalProviderModalState::new();
+        s.focus = Field::ContextWindow;
+        s.handle_key(&key(KeyCode::Char('4')));
+        s.handle_key(&key(KeyCode::Char('k')));
+        s.handle_key(&key(KeyCode::Char('0')));
+        s.handle_key(&key(KeyCode::Char('9')));
+        s.handle_key(&key(KeyCode::Char('6')));
+        s.set_model("m");
+        assert_eq!(s.validate().unwrap().context_window, Some(4096));
+    }
+}
